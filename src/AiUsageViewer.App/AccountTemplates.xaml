<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DataTemplate x:Key="AccountTemplate">
    <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <DockPanel><TextBlock Text="{Binding Provider}" Foreground="{Binding Color}" FontWeight="SemiBold" FontSize="16" /><TextBlock Text="{Binding Name}" HorizontalAlignment="Right" Style="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="160" /></DockPanel>
        <TextBlock Text="{Binding Status}" ToolTip="{Binding Detail}" Style="{DynamicResource Muted}" Margin="0,6,0,8" />
        <ItemsControl ItemsSource="{Binding Windows}"><ItemsControl.ItemTemplate><DataTemplate>
          <StackPanel Margin="0,7,0,9">
            <DockPanel Margin="0,0,0,8"><TextBlock Text="{Binding Label}" /><TextBlock Text="{Binding Percent}" Foreground="{Binding Color}" HorizontalAlignment="Right" FontWeight="SemiBold" /></DockPanel>
            <ProgressBar Value="{Binding Value}" Maximum="100" Foreground="{Binding Color}" AutomationProperties.Name="{Binding Percent}" />
            <TextBlock Text="{Binding Reset}" Style="{DynamicResource Muted}" Margin="0,7,0,0" />
          </StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <ItemsControl ItemsSource="{Binding Money}"><ItemsControl.ItemTemplate><DataTemplate>
          <DockPanel Margin="0,5"><TextBlock Text="{Binding Label}" Style="{DynamicResource Muted}" /><TextBlock Text="{Binding Value}" HorizontalAlignment="Right" /></DockPanel>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="{Binding Updated}" Style="{DynamicResource Muted}" Margin="0,8,0,0" FontSize="10" />
      </StackPanel>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="WidgetAccountTemplate">
    <Border x:Name="CardBody" Style="{DynamicResource Card}" Padding="14" Margin="0,0,0,12">
      <StackPanel>
        <DockPanel Margin="0,0,0,9"><TextBlock Text="{Binding Name}" ToolTip="{Binding Provider}" Foreground="{Binding Color}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="150" /><TextBlock Text="{Binding Status}" Style="{DynamicResource Muted}" HorizontalAlignment="Right" FontSize="10" /></DockPanel>
        <ItemsControl ItemsSource="{Binding WidgetWindows}"><ItemsControl.ItemTemplate><DataTemplate>
          <StackPanel Margin="0,3,0,9"><DockPanel Margin="0,0,0,6"><TextBlock Text="{Binding Label}" FontSize="11" /><TextBlock Text="{Binding Percent}" Foreground="{Binding Color}" HorizontalAlignment="Right" FontSize="11" /></DockPanel><ProgressBar Value="{Binding Value}" Foreground="{Binding Color}" Height="4" ToolTip="{Binding Reset}" /></StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <ItemsControl ItemsSource="{Binding WidgetMoney}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock Text="{Binding Label}" Style="{DynamicResource Muted}" FontSize="10" /><TextBlock Text="{Binding Value}" HorizontalAlignment="Right" FontSize="10" /></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="{Binding NextReset}" Style="{DynamicResource Muted}" FontSize="10" Margin="0,2,0,6" />
        <TextBlock x:Name="Updated" Text="{Binding Updated}" Style="{DynamicResource Muted}" FontSize="9" />
      </StackPanel>
    </Border>
    <DataTemplate.Triggers><DataTrigger Binding="{Binding Compact}" Value="True"><Setter TargetName="CardBody" Property="Padding" Value="10" /><Setter TargetName="CardBody" Property="Margin" Value="0,0,0,6" /><Setter TargetName="Updated" Property="Visibility" Value="Collapsed" /></DataTrigger></DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
