<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:AiUsageViewer.App">
  <!-- QuotaRow in three sizes (main 8 px, widget/tray 6 px, compact 5 px) and the account sections that use it. -->
  <DataTemplate x:Key="QuotaRowMain">
    <StackPanel Margin="0,0,0,16" AutomationProperties.Name="{Binding AccessibleName}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Percent}" FontWeight="SemiBold" FontSize="{StaticResource FontSize.Body}" Foreground="{Binding ValueKey,Converter={StaticResource Token}}" />
        <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSize.Body}" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
      <local:QuotaBar Value="{Binding Value}" Marker="{Binding Marker}" Fill="{Binding FillKey,Converter={StaticResource Token}}" BarHeight="8" MarkerHeight="14" Margin="0,7,0,6" ToolTip="{Binding MarkerTip}" />
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding PaceNote}" Style="{StaticResource Text.Caption}" Foreground="{Binding PaceNoteKey,Converter={StaticResource Token}}" Margin="8,0,0,0" />
        <TextBlock Text="{Binding Reset}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
      <Border Style="{StaticResource Callout.Warn}" Margin="0,12,0,0" Visibility="{Binding HasForecast,Converter={StaticResource BoolVisibility}}">
        <DockPanel>
          <local:Icon Data="{StaticResource Icon.Alert}" Size="16" Foreground="{DynamicResource Warn.CalloutText}" VerticalAlignment="Top" Margin="0,1,10,0" />
          <TextBlock Text="{Binding Forecast}" TextWrapping="Wrap" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Warn.CalloutText}" />
        </DockPanel>
      </Border>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="QuotaRowWidget">
    <StackPanel Margin="0,0,0,12" AutomationProperties.Name="{Binding AccessibleName}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Percent}" FontWeight="SemiBold" FontSize="{StaticResource FontSize.Control}" Foreground="{Binding ValueKey,Converter={StaticResource Token}}" />
        <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
      <local:QuotaBar Value="{Binding Value}" Marker="{Binding Marker}" Fill="{Binding FillKey,Converter={StaticResource Token}}" BarHeight="6" MarkerHeight="12" Margin="0,6,0,4" ToolTip="{Binding MarkerTip}" />
      <TextBlock Text="{Binding WidgetMeta}" FontSize="11.5" Foreground="{Binding WidgetMetaKey,Converter={StaticResource Token}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WidgetMeta}" />
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="QuotaRowCompact">
    <StackPanel AutomationProperties.Name="{Binding AccessibleName}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding ShortValue}" FontWeight="SemiBold" FontSize="{StaticResource FontSize.Micro}" Foreground="{Binding ValueKey,Converter={StaticResource Token}}" />
        <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSize.Micro}" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
      <local:QuotaBar Value="{Binding Value}" Marker="{Binding Marker}" Fill="{Binding FillKey,Converter={StaticResource Token}}" BarHeight="5" MarkerHeight="9" Margin="0,4,0,0" ToolTip="{Binding MarkerTip}" />
    </StackPanel>
  </DataTemplate>

  <!-- Amber callout shown for an account whose last refresh failed or whose data is old. -->
  <DataTemplate x:Key="StaleCallout">
    <Border Style="{StaticResource Callout.Warn}" Margin="0,0,0,12">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{Binding DataContext.L[retry],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.RefreshCommand,RelativeSource={RelativeSource AncestorType=Window}}"
                Height="30" Padding="10,0" Margin="10,0,0,0" VerticalAlignment="Top" Background="{DynamicResource Warn.PillBg}" BorderBrush="{DynamicResource Warn.PillBorder}" Foreground="{DynamicResource Warn.CalloutText}" />
        <local:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Alert}" Size="16" Foreground="{DynamicResource Warn.CalloutText}" VerticalAlignment="Top" Margin="0,1,10,0" />
        <TextBlock Text="{Binding DataContext.L[staleCallout],RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Warn.CalloutText}" />
      </DockPanel>
    </Border>
  </DataTemplate>

  <!-- Main window right rail / Subscriptions page card -->
  <DataTemplate x:Key="SubscriptionCard">
    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
      <StackPanel>
        <DockPanel Margin="0,0,0,16">
          <TextBlock DockPanel.Dock="Right" Text="{Binding Tool}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}" Foreground="{Binding Color,Converter={StaticResource Token}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
        </DockPanel>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StaleCallout}" Focusable="False" Visibility="{Binding IsStale,Converter={StaticResource BoolVisibility}}" />
        <ItemsControl ItemsSource="{Binding Windows}" ItemTemplate="{StaticResource QuotaRowMain}" Focusable="False" />
        <ItemsControl ItemsSource="{Binding Money}" Focusable="False" Visibility="{Binding HasMoney,Converter={StaticResource BoolVisibility}}">
          <ItemsControl.ItemTemplate><DataTemplate>
            <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" /><TextBlock Text="{Binding Label}" Foreground="{DynamicResource Text.Secondary}" /></DockPanel>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding StaleNote}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Warn.Text}" Visibility="{Binding IsStale,Converter={StaticResource BoolVisibility}}" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- Widget account section: no nested card; sections divide with Border.Card. -->
  <DataTemplate x:Key="WidgetAccount">
    <Border BorderBrush="{DynamicResource Border.Card}" BorderThickness="0,0,0,1" Padding="0,14,0,4">
      <StackPanel>
        <DockPanel Margin="0,0,0,10">
          <TextBlock DockPanel.Dock="Right" Text="{Binding Tool}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSize.CardTitle}" FontWeight="SemiBold" Foreground="{Binding Color,Converter={StaticResource Token}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
        </DockPanel>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StaleCallout}" Focusable="False" Visibility="{Binding IsStale,Converter={StaticResource BoolVisibility}}" />
        <ItemsControl ItemsSource="{Binding WidgetWindows}" ItemTemplate="{StaticResource QuotaRowWidget}" Focusable="False" />
        <ItemsControl ItemsSource="{Binding WidgetMoney}" Focusable="False">
          <ItemsControl.ItemTemplate><DataTemplate>
            <DockPanel Margin="0,0,0,8"><TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontSize="{StaticResource FontSize.Control}" FontWeight="SemiBold" /><TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Secondary}" /></DockPanel>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- Tray account section: like the widget, with freshness in the name row. -->
  <DataTemplate x:Key="TrayAccount">
    <Border BorderBrush="{DynamicResource Border.Card}" BorderThickness="0,0,0,1" Padding="0,14,0,4">
      <StackPanel>
        <DockPanel Margin="0,0,0,10">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="FreshDot" Style="{StaticResource Dot}" Width="7" Height="7" Fill="{DynamicResource Ok.Dot}" Margin="0,0,7,0" />
            <TextBlock x:Name="FreshText" Text="{Binding UpdatedTime}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}" />
          </StackPanel>
          <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSize.CardTitle}" FontWeight="SemiBold" Foreground="{Binding Color,Converter={StaticResource Token}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
        </DockPanel>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StaleCallout}" Focusable="False" Visibility="{Binding IsStale,Converter={StaticResource BoolVisibility}}" />
        <ItemsControl ItemsSource="{Binding WidgetWindows}" ItemTemplate="{StaticResource QuotaRowWidget}" Focusable="False" />
        <ItemsControl ItemsSource="{Binding WidgetMoney}" Focusable="False">
          <ItemsControl.ItemTemplate><DataTemplate>
            <DockPanel Margin="0,0,0,8"><TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontSize="{StaticResource FontSize.Control}" FontWeight="SemiBold" /><TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Secondary}" /></DockPanel>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsStale}" Value="True">
        <Setter TargetName="FreshDot" Property="Fill" Value="{DynamicResource Warn.Bar}" />
        <Setter TargetName="FreshText" Property="Text" Value="{Binding StaleNote}" /><Setter TargetName="FreshText" Property="Foreground" Value="{DynamicResource Warn.Text}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Compact widget account: key fact on the name row, Session and Weekly side by side. -->
  <DataTemplate x:Key="CompactAccount">
    <Border BorderBrush="{DynamicResource Border.Card}" BorderThickness="0,0,0,1" Padding="14,10,14,12">
      <StackPanel>
        <DockPanel Margin="0,0,0,8">
          <TextBlock DockPanel.Dock="Right" Text="{Binding CompactFact}" FontSize="{StaticResource FontSize.Micro}" Foreground="{Binding CompactFactKey,Converter={StaticResource Token}}" VerticalAlignment="Center" Margin="8,0,0,0" />
          <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSize.Body}" FontWeight="SemiBold" Foreground="{Binding Color,Converter={StaticResource Token}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
        </DockPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <ContentControl Content="{Binding First}" ContentTemplate="{StaticResource QuotaRowCompact}" Focusable="False" />
          <ContentControl Grid.Column="2" Content="{Binding Second}" ContentTemplate="{StaticResource QuotaRowCompact}" Focusable="False" />
        </Grid>
      </StackPanel>
    </Border>
  </DataTemplate>
</ResourceDictionary>
