<Application x:Class="AiUsageViewer.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Index 0 is the color token dictionary; App.ApplyTheme replaces it for Dark / Light / System. -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme/Tokens.Dark.xaml" />
        <ResourceDictionary Source="Theme/Controls.xaml" />
        <ResourceDictionary Source="AccountTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
