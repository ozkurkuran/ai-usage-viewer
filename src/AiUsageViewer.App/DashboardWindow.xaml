<Window x:Class="AiUsageViewer.App.DashboardWindow" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AiUsageViewer.App"
  Title="Ai UsageNest" Style="{StaticResource {x:Type Window}}" Width="1320" Height="900" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="Swatch" TargetType="Border"><Setter Property="Width" Value="9" /><Setter Property="Height" Value="9" /><Setter Property="CornerRadius" Value="2" /><Setter Property="Margin" Value="0,0,7,0" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style x:Key="HeaderCell" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontSize.Control}" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource Text.Muted}" /></Style>
    <Style x:Key="NumberCell" TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="FontSize" Value="{StaticResource FontSize.Body}" /><Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" /></Style>
  </Window.Resources>
  <Grid Background="{DynamicResource Bg.Window}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="232" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border.Card}" BorderThickness="0,0,1,0" Padding="14,22,14,18">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,26">
          <local:LogoMark Size="22" />
          <TextBlock Text="Ai UsageNest" FontSize="16" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Button Style="{StaticResource NavItem}" Content="{Binding L[settings]}" local:Ui.Icon="{StaticResource Icon.Nav.Settings}" Command="{Binding OpenSettingsCommand}" />
          <Border BorderBrush="{DynamicResource Border.Card}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="10,14,0,0">
            <TextBlock FontSize="{StaticResource FontSize.Caption}" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap">
              <Run Text="{Binding L[privacy],Mode=OneWay}" /><Run Text=" · " /><Hyperlink Command="{Binding OpenPrivacyCommand}" Foreground="{DynamicResource Accent.Text}" TextDecorations="{x:Null}"
                AutomationProperties.Name="{Binding L[privacyPolicy]}"><Run Text="{Binding L[privacyLink],Mode=OneWay}" /></Hyperlink>
            </TextBlock>
          </Border>
        </StackPanel>
        <StackPanel>
          <Button Style="{StaticResource NavItem}" Content="{Binding L[overview]}" local:Ui.Icon="{StaticResource Icon.Nav.Overview}" Command="{Binding NavigateCommand}" CommandParameter="overview"
                  local:Ui.IsActive="{Binding Page,Converter={StaticResource Equals},ConverterParameter=overview}" />
          <Button Style="{StaticResource NavItem}" Content="{Binding L[subscriptions]}" local:Ui.Icon="{StaticResource Icon.Nav.Subscriptions}" Command="{Binding NavigateCommand}" CommandParameter="subscriptions"
                  local:Ui.IsActive="{Binding Page,Converter={StaticResource Equals},ConverterParameter=subscriptions}" />
          <Button Style="{StaticResource NavItem}" Content="{Binding L[models]}" local:Ui.Icon="{StaticResource Icon.Nav.Models}" Command="{Binding NavigateCommand}" CommandParameter="models"
                  local:Ui.IsActive="{Binding Page,Converter={StaticResource Equals},ConverterParameter=models}" />
          <Button Style="{StaticResource NavItem}" Content="{Binding L[projects]}" local:Ui.Icon="{StaticResource Icon.Nav.Projects}" Command="{Binding NavigateCommand}" CommandParameter="projects"
                  local:Ui.IsActive="{Binding Page,Converter={StaticResource Equals},ConverterParameter=projects}" />
          <Button Style="{StaticResource NavItem}" Content="{Binding L[sessions]}" local:Ui.Icon="{StaticResource Icon.Nav.Sessions}" Command="{Binding NavigateCommand}" CommandParameter="sessions"
                  local:Ui.IsActive="{Binding Page,Converter={StaticResource Equals},ConverterParameter=sessions}" />
          <Button Style="{StaticResource NavItem}" Content="OpenRouter" local:Ui.Icon="{StaticResource Icon.Nav.OpenRouter}" Command="{Binding NavigateCommand}" CommandParameter="openrouter"
                  local:Ui.IsActive="{Binding Page,Converter={StaticResource Equals},ConverterParameter=openrouter}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Page -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <DockPanel Margin="32,24,32,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
          <local:StatusPill Kind="{Binding PillKind}" Text="{Binding PillText}" Margin="0,0,10,0" />
          <Button Style="{StaticResource IconButton}" local:Ui.Icon="{StaticResource Icon.Refresh}" Command="{Binding RefreshCommand}" ToolTip="{Binding L[refresh]}" AutomationProperties.Name="{Binding L[refresh]}" Margin="0,0,10,0" />
          <Button Content="{Binding L[widget]}" local:Ui.Icon="{StaticResource Icon.Widget}" Command="{Binding ShowWidgetCommand}" Margin="0,0,10,0" Visibility="{Binding IsOverview,Converter={StaticResource BoolVisibility}}" />
          <Button x:Name="ExportButton" local:Ui.Icon="{StaticResource Icon.Download}" Command="{Binding ExportCommand}" />
        </StackPanel>
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Breadcrumbs}" Margin="0,0,0,6" Visibility="{Binding HasBreadcrumbs,Converter={StaticResource BoolVisibility}}" Focusable="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="Link" Style="{StaticResource Button.Link}" Content="{Binding Label}" Foreground="{DynamicResource Text.Secondary}" FontWeight="Normal" Height="32" Padding="2,0"
                        Command="{Binding DataContext.OpenCrumbCommand,ElementName=Root}" CommandParameter="{Binding}" />
                <TextBlock x:Name="Slash" Text="/" Foreground="{DynamicResource Text.Disabled}" Margin="8,0" VerticalAlignment="Center" />
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter TargetName="Link" Property="Foreground" Value="{DynamicResource Text.Primary}" /><Setter TargetName="Link" Property="FontWeight" Value="Medium" /><Setter TargetName="Slash" Property="Visibility" Value="Collapsed" /></DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Text.PageTitle}" />
          <TextBlock Text="{Binding PageSubtitle}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>

      <DockPanel Grid.Row="1" Margin="32,22,32,0" x:Name="FilterRow">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding ShowDemoPill,Converter={StaticResource BoolVisibility}}">
          <Border Style="{StaticResource Pill.Demo}" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Style="{StaticResource Dot}" Width="6" Height="6" Fill="{DynamicResource Accent.Text}" Margin="0,0,8,0" /><TextBlock Text="{Binding L[demoPill]}" FontWeight="Medium" VerticalAlignment="Center" /></StackPanel>
          </Border>
          <Button Style="{StaticResource Button.Link}" Content="{Binding L[connectAccounts]}" local:Ui.TrailingIcon="{StaticResource Icon.ArrowRight}" Command="{Binding OpenSettingsCommand}" CommandParameter="accounts" />
        </StackPanel>
        <WrapPanel>
          <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range}" AutomationProperties.Name="{Binding L[periodName]}" Margin="0,0,10,0" />
          <ComboBox ItemsSource="{Binding Tools}" SelectedItem="{Binding Tool}" local:Ui.Prefix="{Binding L[toolPrefix]}" AutomationProperties.Name="{Binding L[toolPrefix]}" Margin="0,0,10,0" />
          <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding Model}" local:Ui.Prefix="{Binding L[modelColumn]}" AutomationProperties.Name="{Binding L[modelColumn]}" MaxWidth="280" Margin="0,0,10,0"
                    Visibility="{Binding IsOverview,Converter={StaticResource BoolVisibility}}" />
          <StackPanel Orientation="Horizontal" Visibility="{Binding HasChips,Converter={StaticResource BoolVisibility}}">
            <Rectangle Width="1" Height="24" Fill="{DynamicResource Border.Control}" Margin="4,0,14,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding L[filteredBy]}" Foreground="{DynamicResource Text.Muted}" FontSize="{StaticResource FontSize.Control}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ItemsControl ItemsSource="{Binding Chips}" Focusable="False">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="{DynamicResource Accent.SelectedBg}" BorderBrush="{DynamicResource Accent.SelectedBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.Pill}" Height="36" Padding="14,0,4,0" Margin="0,0,8,0">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Accent.Text}" FontSize="{StaticResource FontSize.Control}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Value}" Foreground="{DynamicResource Accent.TextStrong}" FontSize="{StaticResource FontSize.Control}" FontWeight="Medium" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                    <Button Style="{StaticResource IconButton.Compact}" Width="32" Height="32" local:Ui.Icon="{StaticResource Icon.Close}" Foreground="{DynamicResource Accent.TextStrong}" Margin="2,0,0,0"
                            Command="{Binding DataContext.RemoveChipCommand,ElementName=Root}" CommandParameter="{Binding}" ToolTip="{Binding RemoveName}" AutomationProperties.Name="{Binding RemoveName}" />
                  </StackPanel>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource Button.Link}" Content="{Binding L[clearAll]}" Command="{Binding ClearFocusCommand}" Height="36" />
          </StackPanel>
        </WrapPanel>
      </DockPanel>

      <ScrollViewer Grid.Row="2" x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,20,0,0">
        <StackPanel Margin="32,0,32,40">

          <!-- First run: setup checklist -->
          <Border Style="{StaticResource Card}" Padding="28" Margin="0,0,0,20" x:Name="SetupCard" Visibility="{Binding ShowGettingStarted,Converter={StaticResource BoolVisibility}}">
            <StackPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding SetupProgress}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Right" />
                  <Button Style="{StaticResource Button.Link}" Content="{Binding L[trySample]}" Command="{Binding TrySampleCommand}" Margin="0,6,-4,0" HorizontalAlignment="Right"
                          Visibility="{Binding CanTrySample,Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
                <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource Accent.SelectedBg}" VerticalAlignment="Top" Margin="0,0,18,0"><local:LogoMark Size="24" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <StackPanel>
                  <TextBlock Text="{Binding L[setupTitle]}" Style="{StaticResource Text.SectionTitle}" />
                  <TextBlock Text="{Binding L[setupText]}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left" />
                </StackPanel>
              </DockPanel>
              <ItemsControl x:Name="SetupList" ItemsSource="{Binding SetupSteps}" Margin="0,18,0,0" Focusable="False">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Border Background="{DynamicResource Bg.CardInset}" BorderBrush="{DynamicResource Border.Card}" BorderThickness="1" CornerRadius="12" Padding="20,14" Margin="0,0,0,10">
                    <DockPanel>
                      <Grid DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Ellipse x:Name="Ring" Stroke="{DynamicResource Border.Control}" StrokeThickness="1.5" StrokeDashArray="2 2" />
                        <TextBlock x:Name="Number" Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}" />
                        <local:Icon x:Name="Mark" Data="{StaticResource Icon.Check}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Foreground="{DynamicResource Ok.Dot}" />
                      </Grid>
                      <Button x:Name="Action" DockPanel.Dock="Right" Content="{Binding Action}" Command="{Binding DataContext.OpenSettingsCommand,ElementName=Root}" CommandParameter="{Binding ActionTarget}" VerticalAlignment="Center"
                              Visibility="{Binding HasAction,Converter={StaticResource BoolVisibility}}" Margin="16,0,0,0" />
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Action}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" Margin="16,0,0,0"
                                 Visibility="{Binding ShowDoneNote,Converter={StaticResource BoolVisibility}}" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="{StaticResource FontSize.Body}"><Run Text="{Binding Title,Mode=OneWay}" FontWeight="SemiBold" /><Run x:Name="Optional" Text="" Foreground="{DynamicResource Text.Muted}" /></TextBlock>
                        <TextBlock x:Name="StatusLine" Text="{Binding Status}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Secondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Mono}" FontSize="{StaticResource FontSize.Caption}" Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,0"
                                   Visibility="{Binding HasPath,Converter={StaticResource BoolVisibility}}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Optional}" Value="True"><Setter TargetName="Optional" Property="Text" Value="{Binding Note,StringFormat=' · {0}'}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Done}" Value="True">
                      <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Ok.PillBg}" /><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Ok.PillBorder}" /><Setter TargetName="Ring" Property="StrokeDashArray" Value="{x:Null}" />
                      <Setter TargetName="Number" Property="Visibility" Value="Collapsed" /><Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Warning}" Value="True">
                      <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Warn.PillBg}" /><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Warn.PillBorder}" /><Setter TargetName="Ring" Property="StrokeDashArray" Value="{x:Null}" />
                      <Setter TargetName="Number" Property="Text" Value="!" /><Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Warn.Text}" /><Setter TargetName="Number" Property="FontWeight" Value="Bold" />
                      <Setter TargetName="StatusLine" Property="Foreground" Value="{DynamicResource Warn.Text}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Primary}" Value="True"><Setter TargetName="Action" Property="Style" Value="{StaticResource Button.Primary}" /><Setter TargetName="Action" Property="local:Ui.Icon" Value="{StaticResource Icon.Plus}" /></DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Overview -->
          <Grid x:Name="OverviewGrid" Visibility="{Binding IsOverview,Converter={StaticResource BoolVisibility}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel x:Name="MainColumn">
              <Border Style="{StaticResource Card}" Padding="26,24">
                <StackPanel>
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding L[apiEquivalent]}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" />
                        <Border Background="Transparent" ToolTip="{Binding PriceCoverage}" AutomationProperties.Name="{Binding PriceCoverage}" Margin="6,0,0,0">
                          <local:Icon Data="{StaticResource Icon.Info}" Size="15" Foreground="{DynamicResource Text.Muted}" />
                        </Border>
                      </StackPanel>
                      <TextBlock x:Name="Cost" Text="{Binding CostValue}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource Accent.TextStrong}" HorizontalAlignment="Right" Margin="0,8,0,0" />
                      <TextBlock x:Name="CostNote" Text="{Binding CostNote}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}"><Run Text="{Binding L[tokens],Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding PeriodLabel,Mode=OneWay}" /></TextBlock>
                      <TextBlock x:Name="Hero" Text="{Binding HeroValue}" Style="{StaticResource Text.Hero}" Margin="0,6,0,0" />
                      <TextBlock x:Name="HeroNote" Text="{Binding L[noUsageRecorded]}" Style="{StaticResource Text.Caption}" FontSize="{StaticResource FontSize.Control}" Margin="0,4,0,0" Visibility="Collapsed" />
                    </StackPanel>
                  </DockPanel>
                  <StackPanel x:Name="Mix" Margin="0,22,0,0">
                    <local:MixBar Input="{Binding MixInput}" Cache="{Binding MixCache}" Output="{Binding MixOutput}" BarHeight="10" />
                    <UniformGrid Columns="3" Margin="0,16,0,0">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Swatch}" Background="{DynamicResource Chart.Input}" /><TextBlock Text="{Binding L[input]}" Foreground="{DynamicResource Text.Secondary}" FontSize="{StaticResource FontSize.Control}" /></StackPanel>
                        <TextBlock Margin="0,6,0,0"><Run Text="{Binding Input,Mode=OneWay}" FontSize="20" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding InputShare,Mode=OneWay}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}" /></TextBlock>
                      </StackPanel>
                      <StackPanel>
                        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Swatch}" Background="{DynamicResource Chart.Cache}" /><TextBlock Text="{Binding L[cache]}" Foreground="{DynamicResource Text.Secondary}" FontSize="{StaticResource FontSize.Control}" /></StackPanel>
                        <TextBlock Margin="0,6,0,0"><Run Text="{Binding Cache,Mode=OneWay}" FontSize="20" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding CacheShare,Mode=OneWay}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}" /></TextBlock>
                      </StackPanel>
                      <StackPanel>
                        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Swatch}" Background="{DynamicResource Chart.Output}" /><TextBlock Text="{Binding L[output]}" Foreground="{DynamicResource Text.Secondary}" FontSize="{StaticResource FontSize.Control}" /></StackPanel>
                        <TextBlock Margin="0,6,0,0"><Run Text="{Binding Output,Mode=OneWay}" FontSize="20" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding OutputShare,Mode=OneWay}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}" /></TextBlock>
                      </StackPanel>
                    </UniformGrid>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="24,22">
                <StackPanel>
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" x:Name="HistoryLegend">
                      <Border Style="{StaticResource Swatch}" Background="{DynamicResource Chart.Input}" /><TextBlock Text="{Binding L[input]}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,14,0" />
                      <Border Style="{StaticResource Swatch}" Background="{DynamicResource Chart.Cache}" /><TextBlock Text="{Binding L[cache]}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,14,0" />
                      <Border Style="{StaticResource Swatch}" Background="{DynamicResource Chart.Output}" /><TextBlock Text="{Binding L[output]}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Secondary}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="{Binding L[activity]}" Style="{StaticResource Text.CardTitle}" />
                      <TextBlock Text="{Binding HistoryCaption}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                  </DockPanel>
                  <Grid Height="300" Margin="0,18,0,0">
                    <local:UsageHistoryChart x:Name="History" Bars="{Binding HistoryBars}" Now="{Binding HistoryNow}" Format="{Binding Format}" Labels="{Binding L}" AutomationProperties.Name="{Binding L[activity]}" />
                    <Grid x:Name="HistoryEmpty" Visibility="Collapsed">
                      <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                      <Rectangle Height="1" VerticalAlignment="Top" Stroke="{DynamicResource Border.Control}" StrokeDashArray="3 3" />
                      <Rectangle Grid.Row="1" Height="1" VerticalAlignment="Top" Stroke="{DynamicResource Border.Control}" StrokeDashArray="3 3" />
                      <Rectangle Grid.Row="2" Height="1" VerticalAlignment="Top" Stroke="{DynamicResource Border.Control}" StrokeDashArray="3 3" />
                      <Rectangle Grid.Row="2" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Chart.Baseline}" />
                      <StackPanel Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Background="{DynamicResource Bg.Card}">
                        <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource Bg.Control}" HorizontalAlignment="Center"><local:Icon Data="{StaticResource Icon.Chart}" Size="22" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBlock Text="{Binding L[nothingToChart]}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Text="{Binding L[nothingToChartText]}" Foreground="{DynamicResource Text.Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                      </StackPanel>
                    </Grid>
                  </Grid>
                </StackPanel>
              </Border>

              <Grid x:Name="LowerCards" Margin="0,20,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border x:Name="HeatCard" Style="{StaticResource Card}" Padding="24,22">
                  <StackPanel>
                    <TextBlock Text="{Binding L[heatmap]}" Style="{StaticResource Text.CardTitle}" />
                    <TextBlock Text="{Binding L[processedPerDay]}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,16" />
                    <local:HeatmapChart Days="{Binding HeatDays}" Format="{Binding Format}" HorizontalAlignment="Left" AutomationProperties.Name="{Binding L[heatmap]}" />
                    <DockPanel Margin="0,16,0,0">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding L[less]}" Style="{StaticResource Text.Caption}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource Heat.0}" Margin="0,0,3,0" /><Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource Heat.1}" Margin="0,0,3,0" />
                        <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource Heat.2}" Margin="0,0,3,0" /><Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource Heat.3}" Margin="0,0,3,0" />
                        <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource Heat.4}" />
                        <TextBlock Text="{Binding L[more]}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="{Binding L[outlinedToday]}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    </DockPanel>
                  </StackPanel>
                </Border>
                <Border x:Name="ModelCard" Grid.Column="2" Style="{StaticResource Card}" Padding="24,22">
                  <StackPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="{Binding L[allModelsLink]}" local:Ui.TrailingIcon="{StaticResource Icon.ArrowRight}" Command="{Binding NavigateCommand}" CommandParameter="models" VerticalAlignment="Top" Margin="0,-6,-4,0" />
                      <TextBlock Text="{Binding L[byModel]}" Style="{StaticResource Text.CardTitle}" />
                    </DockPanel>
                    <TextBlock FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,14"><Run Text="{Binding PeriodLabel,Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Tool.Label,Mode=OneWay}" /></TextBlock>
                    <ItemsControl ItemsSource="{Binding TopModels}" Focusable="False">
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel Margin="0,0,0,16">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Tokens}" FontWeight="SemiBold" />
                            <Ellipse Style="{StaticResource Dot}" Fill="{Binding DotKey,Converter={StaticResource Token}}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Model}" Style="{StaticResource Text.Mono}" FontSize="{StaticResource FontSize.Body}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Model}" />
                            <TextBlock Text="{Binding Tool}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                          </DockPanel>
                          <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ShareText}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}" Width="44" TextAlignment="Right" />
                            <local:QuotaBar Value="{Binding Share}" Fill="{Binding DotKey,Converter={StaticResource Token}}" BarHeight="6" VerticalAlignment="Center" />
                          </DockPanel>
                        </StackPanel>
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>

            <StackPanel x:Name="Rail" Grid.Column="2">
              <DockPanel Margin="4,0,0,14" Height="36">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="{Binding L[manage]}" Command="{Binding OpenSettingsCommand}" CommandParameter="accounts" Visibility="{Binding HasSubscriptions,Converter={StaticResource BoolVisibility}}" />
                <TextBlock Text="{Binding L[subscriptions]}" Style="{StaticResource Text.CardTitle}" FontSize="16" VerticalAlignment="Center" />
              </DockPanel>
              <ItemsControl ItemsSource="{Binding Accounts}" ItemTemplate="{StaticResource SubscriptionCard}" Focusable="False" />
              <Grid Visibility="{Binding HasSubscriptions,Converter={StaticResource InverseBoolVisibility}}" Margin="0,0,0,14">
                <Rectangle RadiusX="14" RadiusY="14" Stroke="{DynamicResource Border.Control}" StrokeDashArray="4 3" StrokeThickness="1" />
                <StackPanel Margin="26,30">
                  <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource Bg.Control}" HorizontalAlignment="Center"><local:Icon Data="{StaticResource Icon.Nav.Subscriptions}" Size="22" Foreground="{DynamicResource Accent.Text}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <TextBlock Text="{Binding L[noAccountsTitle]}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" />
                  <TextBlock Text="{Binding L[noAccountsText]}" Foreground="{DynamicResource Text.Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,18" />
                  <Button Style="{StaticResource Button.Primary}" Content="{Binding L[addAccount]}" local:Ui.Icon="{StaticResource Icon.Plus}" Command="{Binding OpenSettingsCommand}" CommandParameter="accounts:new" HorizontalAlignment="Center" />
                </StackPanel>
              </Grid>
              <ItemsControl ItemsSource="{Binding OpenRouterCards}" Focusable="False">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DataContext.L[apiKey],ElementName=Root}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Spend}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DataContext.L[spendLast30],ElementName=Root}" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                      </DockPanel>
                      <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="{Binding DataContext.L[history],ElementName=Root}" local:Ui.TrailingIcon="{StaticResource Icon.ArrowRight}"
                                Command="{Binding DataContext.NavigateCommand,ElementName=Root}" CommandParameter="openrouter" Margin="0,0,-4,0" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                      </DockPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel Margin="6,2,0,0" Visibility="{Binding HasSubscriptions,Converter={StaticResource BoolVisibility}}">
                <Rectangle Width="2" Height="13" Fill="{DynamicResource Pace.Marker}" VerticalAlignment="Top" Margin="0,2,10,0" RadiusX="1" RadiusY="1" />
                <TextBlock Text="{Binding PaceLegend}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
              </DockPanel>
            </StackPanel>
          </Grid>

          <!-- Subscriptions -->
          <StackPanel Visibility="{Binding IsSubscriptions,Converter={StaticResource BoolVisibility}}">
            <ItemsControl ItemsSource="{Binding Accounts}" Focusable="False">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate><ContentControl Content="{Binding}" ContentTemplate="{StaticResource SubscriptionCard}" Width="420" Margin="0,0,20,0" Focusable="False" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding KeyAccounts}" Focusable="False">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate><ContentControl Content="{Binding}" ContentTemplate="{StaticResource SubscriptionCard}" Width="420" Margin="0,0,20,0" Focusable="False" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="4,4,0,0" HorizontalAlignment="Left" Visibility="{Binding HasSubscriptions,Converter={StaticResource BoolVisibility}}">
              <Rectangle Width="2" Height="13" Fill="{DynamicResource Pace.Marker}" VerticalAlignment="Top" Margin="0,2,10,0" RadiusX="1" RadiusY="1" />
              <TextBlock Text="{Binding PaceLegend}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
            </DockPanel>
            <Button Style="{StaticResource Button.Primary}" Content="{Binding L[addAccount]}" local:Ui.Icon="{StaticResource Icon.Plus}" Command="{Binding OpenSettingsCommand}" CommandParameter="accounts:new"
                    HorizontalAlignment="Left" Margin="0,20,0,0" Visibility="{Binding HasSubscriptions,Converter={StaticResource InverseBoolVisibility}}" />
          </StackPanel>

          <!-- Models / Projects / Sessions -->
          <StackPanel Visibility="{Binding IsTable,Converter={StaticResource BoolVisibility}}">
            <UniformGrid x:Name="SummaryCards" Columns="4" Margin="0,0,-20,20">
              <Border Style="{StaticResource Card}" Padding="22,20" Margin="0,0,20,0"><StackPanel><TextBlock Text="{Binding L[tokensLabel]}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}" /><TextBlock Text="{Binding Total}" Style="{StaticResource Text.Kpi}" Margin="0,8,0,0" /></StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="22,20" Margin="0,0,20,0"><StackPanel><TextBlock Text="{Binding CountLabel}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}" /><TextBlock Text="{Binding GroupCount}" Style="{StaticResource Text.Kpi}" Margin="0,8,0,0" /></StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="22,20" Margin="0,0,20,0"><StackPanel><TextBlock Text="{Binding L[apiEquivalent]}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}" /><TextBlock Text="{Binding EstimatedCost}" Style="{StaticResource Text.Kpi}" Foreground="{DynamicResource Accent.TextStrong}" Margin="0,8,0,0" ToolTip="{Binding PriceCoverage}" /></StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="22,20" Margin="0,0,20,0">
                <StackPanel>
                  <TextBlock Text="{Binding L[mixLabel]}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}" />
                  <local:MixBar Input="{Binding MixInput}" Cache="{Binding MixCache}" Output="{Binding MixOutput}" BarHeight="8" Margin="0,14,0,10" />
                  <WrapPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,8,0"><Run Text="{Binding L[input],Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding InputShare,Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,8,0"><Run Text="{Binding L[cache],Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding CacheShare,Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{Binding L[output],Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding OutputShare,Mode=OneWay}" /></TextBlock>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}" Padding="0">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel MinWidth="820">
                  <Border Background="{DynamicResource Bg.CardInset}" CornerRadius="14,14,0,0" Height="52" Padding="28,0">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="110" /><ColumnDefinition Width="96" /><ColumnDefinition Width="96" /><ColumnDefinition Width="96" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding TableNameHeader}" Style="{StaticResource HeaderCell}" />
                      <TextBlock Grid.Column="1" Text="{Binding L[share]}" Style="{StaticResource HeaderCell}" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding L[totalShort]}" Style="{StaticResource HeaderCell}" Foreground="{DynamicResource Text.Primary}" FontWeight="SemiBold" /><local:Icon Data="{StaticResource Icon.ArrowDown}" Size="14" Foreground="{DynamicResource Accent.Text}" Margin="4,0,0,0" VerticalAlignment="Center" /></StackPanel>
                      <TextBlock Grid.Column="3" Text="{Binding L[input]}" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="4" Text="{Binding L[output]}" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="5" Text="{Binding L[cache]}" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="6" Text="{Binding L[apiApprox]}" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                    </Grid>
                  </Border>
                  <ListBox x:Name="UsageGrid" ItemsSource="{Binding Groups}" Foreground="{DynamicResource Text.Primary}" ItemContainerStyle="{StaticResource TableRow}" BorderThickness="0" Background="Transparent"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" MouseDoubleClick="OpenGroup" KeyDown="GroupKeyDown"
                           AutomationProperties.Name="{Binding PageTitle}">
                    <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate></ListBox.Template>
                    <ListBox.ItemTemplate><DataTemplate>
                      <Grid MinHeight="64" AutomationProperties.Name="{Binding Name}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="110" /><ColumnDefinition Width="96" /><ColumnDefinition Width="96" /><ColumnDefinition Width="96" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                        <DockPanel VerticalAlignment="Center" Margin="0,10,16,10">
                          <Ellipse DockPanel.Dock="Left" Style="{StaticResource Dot}" Fill="{Binding DotKey,Converter={StaticResource Token}}" Margin="0,6,12,0" VerticalAlignment="Top" Visibility="{Binding ShowDot,Converter={StaticResource BoolVisibility}}" />
                          <StackPanel>
                            <TextBlock x:Name="NameCell" Text="{Binding Name}" FontSize="{StaticResource FontSize.Body}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            <TextBlock Text="{Binding Tool}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}" Margin="0,2,0,0" Visibility="{Binding Tool,Converter={StaticResource TextVisibility}}" />
                          </StackPanel>
                        </DockPanel>
                        <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                          <TextBlock DockPanel.Dock="Right" Text="{Binding ShareText}" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}" Width="44" TextAlignment="Right" />
                          <local:QuotaBar x:Name="ShareBar" Value="{Binding Share}" Fill="{Binding DotKey,Converter={StaticResource Token}}" BarHeight="6" Margin="0,0,10,0" />
                        </DockPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Total}" Style="{StaticResource NumberCell}" Foreground="{DynamicResource Text.Primary}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="{Binding Input}" Style="{StaticResource NumberCell}" />
                        <TextBlock Grid.Column="4" Text="{Binding Output}" Style="{StaticResource NumberCell}" />
                        <TextBlock Grid.Column="5" Text="{Binding Cache}" Style="{StaticResource NumberCell}" />
                        <TextBlock Grid.Column="6" Text="{Binding Cost}" Style="{StaticResource NumberCell}" Foreground="{DynamicResource Accent.TextStrong}" />
                      </Grid>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsModel}" Value="True"><Setter TargetName="NameCell" Property="FontFamily" Value="{StaticResource Font.Mono}" /></DataTrigger>
                        <DataTrigger Binding="{Binding ShowDot}" Value="False"><Setter TargetName="ShareBar" Property="Fill" Value="{DynamicResource Chart.Input}" /></DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                  <Border Background="{DynamicResource Bg.CardInset}" BorderBrush="{DynamicResource Border.Row}" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14" MinHeight="56" Padding="28,0">
                    <Grid VerticalAlignment="Center">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="110" /><ColumnDefinition Width="96" /><ColumnDefinition Width="96" /><ColumnDefinition Width="96" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding L[totalRow]}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"><Run Text="{Binding GroupCountText,Mode=OneWay}" /></TextBlock>
                      <TextBlock Grid.Column="2" Text="{Binding Total}" Style="{StaticResource NumberCell}" Foreground="{DynamicResource Text.Primary}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="3" Text="{Binding Input}" Style="{StaticResource NumberCell}" Foreground="{DynamicResource Text.Primary}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="4" Text="{Binding Output}" Style="{StaticResource NumberCell}" Foreground="{DynamicResource Text.Primary}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="5" Text="{Binding Cache}" Style="{StaticResource NumberCell}" Foreground="{DynamicResource Text.Primary}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="6" Text="{Binding EstimatedCost}" Style="{StaticResource NumberCell}" Foreground="{DynamicResource Accent.TextStrong}" FontWeight="SemiBold" />
                    </Grid>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Border>
            <DockPanel Margin="2,16,0,0">
              <local:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Top" Margin="0,1,10,0" />
              <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontSize.Control}" Foreground="{DynamicResource Text.Muted}">
                <Run Text="{Binding L[pricesNote],Mode=OneWay}" /><Run Text=" " /><Hyperlink Command="{Binding OpenSettingsCommand}" CommandParameter="prices" Foreground="{DynamicResource Accent.Text}" TextDecorations="{x:Null}"><Run Text="{Binding L[editPrices],Mode=OneWay}" /></Hyperlink>
              </TextBlock>
            </DockPanel>
          </StackPanel>

          <!-- OpenRouter -->
          <local:OpenRouterView x:Name="OpenRouterPage" DataContext="{Binding OpenRouter}" Visibility="{Binding DataContext.IsOpenRouter,ElementName=Root,Converter={StaticResource BoolVisibility}}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
