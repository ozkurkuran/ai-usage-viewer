<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:local="clr-namespace:AiUsageViewer.App">
  <!-- Shared metrics, type ramp and control styles. Colors come only from Tokens.Dark/Light.xaml. -->
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Icons.xaml" /></ResourceDictionary.MergedDictionaries>
  <FontFamily x:Key="Font.Sans">pack://application:,,,/Assets/Fonts/#Geist, Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Mono">pack://application:,,,/Assets/Fonts/#Geist Mono, Cascadia Mono, Consolas</FontFamily>
  <CornerRadius x:Key="Radius.Card">14</CornerRadius>
  <CornerRadius x:Key="Radius.SettingsCard">12</CornerRadius>
  <CornerRadius x:Key="Radius.Control">8</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">18</CornerRadius>
  <CornerRadius x:Key="Radius.PillSmall">13</CornerRadius>
  <CornerRadius x:Key="Radius.PillTiny">15</CornerRadius>
  <Thickness x:Key="Pad.Page">32,26,32,40</Thickness>
  <Thickness x:Key="Pad.Card">22</Thickness>
  <sys:Double x:Key="Size.NavItem">38</sys:Double>
  <sys:Double x:Key="Size.Button">36</sys:Double>
  <sys:Double x:Key="Size.ButtonDialog">38</sys:Double>
  <sys:Double x:Key="Size.Input">38</sys:Double>
  <sys:Double x:Key="FontSize.PageTitle">26</sys:Double>
  <sys:Double x:Key="FontSize.Hero">40</sys:Double>
  <sys:Double x:Key="FontSize.Kpi">24</sys:Double>
  <sys:Double x:Key="FontSize.SectionTitle">18</sys:Double>
  <sys:Double x:Key="FontSize.DialogTitle">16</sys:Double>
  <sys:Double x:Key="FontSize.CardTitle">15</sys:Double>
  <sys:Double x:Key="FontSize.Body">14</sys:Double>
  <sys:Double x:Key="FontSize.Control">13</sys:Double>
  <sys:Double x:Key="FontSize.Caption">12</sys:Double>
  <sys:Double x:Key="FontSize.Micro">11</sys:Double>

  <BooleanToVisibilityConverter x:Key="BoolVisibility" />
  <local:InverseBoolVisibilityConverter x:Key="InverseBoolVisibility" />
  <local:TextVisibilityConverter x:Key="TextVisibility" />
  <local:EqualsConverter x:Key="Equals" />
  <local:TokenBrushConverter x:Key="Token" />

  <!-- 2 px accent ring, offset 2 px from the control. -->
  <Style x:Key="FocusRing">
    <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
      <Rectangle Margin="-4" Stroke="{DynamicResource Accent.Text}" StrokeThickness="2" RadiusX="10" RadiusY="10" SnapsToDevicePixels="True" />
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FocusRingRound">
    <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
      <Rectangle Margin="-4" Stroke="{DynamicResource Accent.Text}" StrokeThickness="2" RadiusX="15" RadiusY="15" SnapsToDevicePixels="True" />
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Bg.Window}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>
  <Style TargetType="UserControl">
    <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

  <!-- Type ramp -->
  <Style x:Key="Text.PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontSize.PageTitle}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /></Style>
  <Style x:Key="Text.Hero" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontSize.Hero}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /></Style>
  <Style x:Key="Text.Kpi" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontSize.Kpi}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /></Style>
  <Style x:Key="Text.SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontSize.SectionTitle}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /></Style>
  <Style x:Key="Text.DialogTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontSize.DialogTitle}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /></Style>
  <Style x:Key="Text.CardTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontSize.CardTitle}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /></Style>
  <Style x:Key="Text.Body" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontSize.Body}" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /></Style>
  <Style x:Key="Text.Label" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontSize.Control}" /><Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" /></Style>
  <Style x:Key="Text.Caption" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" /><Setter Property="Foreground" Value="{DynamicResource Text.Muted}" /></Style>
  <Style x:Key="Text.Micro" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontSize.Micro}" /><Setter Property="Foreground" Value="{DynamicResource Text.Muted}" /></Style>
  <Style x:Key="Text.Mono" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Font.Mono}" /><Setter Property="FontSize" Value="{StaticResource FontSize.Control}" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /></Style>
  <Style x:Key="Text.Overline" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource FontSize.Control}" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="{DynamicResource Text.Muted}" /><Setter Property="Margin" Value="0,0,0,10" /></Style>

  <!-- Surfaces -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Bg.Card}" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Card}" />
    <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" /><Setter Property="Padding" Value="{StaticResource Pad.Card}" />
  </Style>
  <Style x:Key="SettingsCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Bg.Card}" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Card}" />
    <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{StaticResource Radius.SettingsCard}" />
  </Style>
  <!-- One 52 px settings row; rows are separated by Border.Row. -->
  <Style x:Key="SettingsRow" TargetType="Border">
    <Setter Property="MinHeight" Value="52" /><Setter Property="Padding" Value="16,9" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Row}" /><Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style x:Key="Callout.Warn" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Warn.CalloutBg}" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="12,10" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Warn.CalloutText}" />
  </Style>
  <Style x:Key="Callout.Info" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Bg.Card}" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Card}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="16,12" /><Setter Property="TextElement.Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style x:Key="Pill.Demo" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Accent.SelectedBg}" /><Setter Property="CornerRadius" Value="{StaticResource Radius.PillTiny}" /><Setter Property="Height" Value="30" /><Setter Property="Padding" Value="12,0" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Accent.TextStrong}" /><Setter Property="TextElement.FontSize" Value="{StaticResource FontSize.Control}" />
  </Style>
  <Style x:Key="Badge" TargetType="Border">
    <Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="8,3" /><Setter Property="Background" Value="{DynamicResource Bg.Control}" />
    <Setter Property="TextElement.FontSize" Value="{StaticResource FontSize.Caption}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style x:Key="Dot" TargetType="Ellipse"><Setter Property="Width" Value="8" /><Setter Property="Height" Value="8" /><Setter Property="VerticalAlignment" Value="Center" /></Style>

  <!-- Buttons: Secondary (default), Primary, Ghost, Danger-ghost, Link, Icon -->
  <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
    <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
        <local:Icon x:Name="Glyph" Data="{TemplateBinding local:Ui.Icon}" Size="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
        <local:Icon x:Name="Trailing" Data="{TemplateBinding local:Ui.TrailingIcon}" Size="16" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
      </StackPanel>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="local:Ui.Icon" Value="{x:Null}"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" /></Trigger>
      <Trigger Property="local:Ui.TrailingIcon" Value="{x:Null}"><Setter TargetName="Trailing" Property="Visibility" Value="Collapsed" /></Trigger>
      <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="Glyph" Property="Margin" Value="0" /></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource Bg.ControlHover}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.45" /></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /><Setter Property="Background" Value="{DynamicResource Bg.Control}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,0" /><Setter Property="Height" Value="{StaticResource Size.Button}" /><Setter Property="FontSize" Value="{StaticResource FontSize.Control}" />
    <Setter Property="FontWeight" Value="Medium" /><Setter Property="Cursor" Value="Hand" /><Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" /><Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
  </Style>
  <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource Accent.Fill}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent.Fill}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" /><Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
          <local:Icon x:Name="Glyph" Data="{TemplateBinding local:Ui.Icon}" Size="16" Margin="0,0,8,0" Foreground="{TemplateBinding Foreground}" />
          <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
        </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="local:Ui.Icon" Value="{x:Null}"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource Accent.FillHover}" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.45" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style x:Key="Button.DangerGhost" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
    <Setter Property="Foreground" Value="{DynamicResource Danger.Text}" /><Setter Property="Padding" Value="8,0" />
  </Style>
  <!-- Inline text action ("Manage", "History →"); keeps a 36 px hit target. -->
  <Style x:Key="Button.Link" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="4,0" />
    <Setter Property="Height" Value="36" /><Setter Property="Foreground" Value="{DynamicResource Accent.Text}" /><Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Body" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <local:Icon x:Name="Glyph" Data="{TemplateBinding local:Ui.Icon}" Size="15" Margin="0,0,6,0" Foreground="{TemplateBinding Foreground}" />
          <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
          <local:Icon x:Name="Trailing" Data="{TemplateBinding local:Ui.TrailingIcon}" Size="15" Margin="5,0,0,0" Foreground="{TemplateBinding Foreground}" />
        </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="local:Ui.Icon" Value="{x:Null}"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="local:Ui.TrailingIcon" Value="{x:Null}"><Setter TargetName="Trailing" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource Bg.ControlHover}" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.45" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="0" /><Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
  </Style>
  <Style x:Key="IconButton.Widget" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style x:Key="IconButton.Compact" TargetType="Button" BasedOn="{StaticResource IconButton.Widget}">
    <Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" />
  </Style>

  <!-- Main and settings navigation item -->
  <Style x:Key="NavItem" TargetType="Button">
    <Setter Property="Height" Value="{StaticResource Size.NavItem}" /><Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Body" Background="Transparent" CornerRadius="{StaticResource Radius.Control}" Padding="12,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <local:Icon x:Name="Glyph" Data="{TemplateBinding local:Ui.Icon}" Size="18" Foreground="{TemplateBinding Foreground}" />
          <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False" />
        </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource Bg.NavHover}" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /></Trigger>
        <Trigger Property="local:Ui.IsActive" Value="True">
          <Setter TargetName="Body" Property="Background" Value="{DynamicResource Accent.SelectedBg}" /><Setter Property="Foreground" Value="{DynamicResource Text.Selected}" />
          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Accent.Text}" /><Setter Property="FontWeight" Value="Medium" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Segmented control: a horizontal ListBox (items expose selection state). -->
  <Style x:Key="SegmentItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" /><Setter Property="FontSize" Value="{StaticResource FontSize.Control}" />
    <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Body" Height="30" Padding="14,0" CornerRadius="7" Background="Transparent"><ContentPresenter VerticalAlignment="Center" /></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource Accent.SegmentBg}" /><Setter Property="Foreground" Value="{DynamicResource Text.Selected}" /><Setter Property="FontWeight" Value="Medium" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Segmented" TargetType="ListBox">
    <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentItem}" /><Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /><Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter.Value></Setter>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
      <Border Background="{DynamicResource Bg.Segment}" BorderBrush="{DynamicResource Border.Segment}" BorderThickness="1" CornerRadius="10" Padding="3"><ItemsPresenter /></Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Select: dropdown button with an optional muted prefix label and a chevron. -->
  <Style x:Key="SelectItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /><Setter Property="Padding" Value="12,8" /><Setter Property="FontSize" Value="{StaticResource FontSize.Control}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Body" Padding="{TemplateBinding Padding}" CornerRadius="6" Background="Transparent"><ContentPresenter /></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource Accent.SelectedBg}" /></Trigger>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource Bg.ControlHover}" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /><Setter Property="FontSize" Value="{StaticResource FontSize.Control}" />
    <Setter Property="Height" Value="{StaticResource Size.Button}" /><Setter Property="MinWidth" Value="110" /><Setter Property="Cursor" Value="Hand" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource SelectItem}" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
      <ToggleButton IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Focusable="False" ClickMode="Press">
        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Box" Background="{DynamicResource Bg.Control}" BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" />
          <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Bg.ControlHover}" /></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <DockPanel Margin="14,0,12,0" IsHitTestVisible="False">
        <local:Icon DockPanel.Dock="Right" Data="{StaticResource Icon.ChevronDown}" Size="16" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Text.Muted}" />
        <TextBlock x:Name="Prefix" Text="{TemplateBinding local:Ui.Prefix}" Foreground="{DynamicResource Text.Muted}" Margin="0,0,8,0" VerticalAlignment="Center" />
        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" HorizontalAlignment="Left" TextElement.FontWeight="Medium" />
      </DockPanel>
      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
        <Border Background="{DynamicResource Bg.Tooltip}" BorderBrush="{DynamicResource Border.Tooltip}" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,0,8,8"
                MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}">
          <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.35" /></Border.Effect>
          <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
        </Border>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="local:Ui.Prefix" Value="{x:Null}"><Setter TargetName="Prefix" Property="Visibility" Value="Collapsed" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
    </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Select.Input" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Height" Value="{StaticResource Size.Input}" /></Style>

  <!-- Text input with optional prefix ($), suffix (/ 1M) and placeholder. -->
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /><Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent.Fill}" /><Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Height" Value="{StaticResource Size.Input}" /><Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Border x:Name="Box" Background="{DynamicResource Bg.Input}" BorderBrush="{DynamicResource Border.Input}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" SnapsToDevicePixels="True">
        <DockPanel Margin="12,0">
          <local:Icon x:Name="LeadIcon" DockPanel.Dock="Left" Data="{TemplateBinding local:Ui.Icon}" Size="16" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource Text.Muted}" />
          <TextBlock x:Name="Prefix" DockPanel.Dock="Left" Text="{TemplateBinding local:Ui.Prefix}" Foreground="{DynamicResource Text.Muted}" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock x:Name="Suffix" DockPanel.Dock="Right" Text="{TemplateBinding local:Ui.Suffix}" Foreground="{DynamicResource Text.Muted}" FontSize="{StaticResource FontSize.Control}" Margin="8,0,0,0" VerticalAlignment="Center" />
          <Grid>
            <TextBlock x:Name="Hint" Text="{TemplateBinding local:Ui.Placeholder}" Foreground="{DynamicResource Text.Disabled}" VerticalAlignment="Center" Visibility="Collapsed" TextTrimming="CharacterEllipsis" Margin="2,0,0,0" />
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
          </Grid>
        </DockPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible" /></Trigger>
        <Trigger Property="local:Ui.Prefix" Value="{x:Null}"><Setter TargetName="Prefix" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="local:Ui.Suffix" Value="{x:Null}"><Setter TargetName="Suffix" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="local:Ui.Icon" Value="{x:Null}"><Setter TargetName="LeadIcon" Property="Visibility" Value="Collapsed" /></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Border.Control}" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent.Text}" /><Setter TargetName="Box" Property="BorderThickness" Value="2" /></Trigger>
        <Trigger Property="Tag" Value="invalid"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Danger.Text}" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.45" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /><Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" /><Setter Property="Height" Value="{StaticResource Size.Input}" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
      <Border x:Name="Box" Background="{DynamicResource Bg.Input}" BorderBrush="{DynamicResource Border.Input}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}">
        <ScrollViewer x:Name="PART_ContentHost" Margin="12,0" VerticalAlignment="Center" Focusable="False" />
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent.Text}" /><Setter TargetName="Box" Property="BorderThickness" Value="2" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Toggle switch 40×22 with a 16 px knob. -->
  <Style TargetType="local:ToggleSwitch">
    <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}" /><Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:ToggleSwitch">
      <Grid Width="44" Height="36" Background="Transparent">
        <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="{DynamicResource Toggle.OffBg}">
          <Ellipse x:Name="Knob" Width="16" Height="16" Margin="3,0" HorizontalAlignment="Left" Fill="{DynamicResource Toggle.OffKnob}" />
        </Border>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent.Fill}" />
          <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Toggle.OnKnob}" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.4" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Slider: 4 px track, accent fill, 16 px knob. -->
  <Style x:Key="SliderFill" TargetType="RepeatButton"><Setter Property="Focusable" Value="False" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{DynamicResource Accent.Fill}" /></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SliderRest" TargetType="RepeatButton"><Setter Property="Focusable" Value="False" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{DynamicResource Bg.Track}" /></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" /><Setter Property="Height" Value="24" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
      <Track x:Name="PART_Track" VerticalAlignment="Center">
        <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}" /></Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRest}" /></Track.IncreaseRepeatButton>
        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Width="16" Height="16" Fill="{DynamicResource Toggle.OnKnob}" Stroke="{DynamicResource Accent.Fill}" StrokeThickness="2" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      </Track>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Status pill: ok · refreshing · stale · empty -->
  <Style TargetType="local:StatusPill">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:StatusPill">
      <Border x:Name="Body" Height="36" Padding="14,0" CornerRadius="{StaticResource Radius.Pill}" BorderThickness="1"
              Background="{DynamicResource Neutral.PillBg}" BorderBrush="{DynamicResource Neutral.PillBorder}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="DotMark" Style="{StaticResource Dot}" Width="7" Height="7" Fill="{DynamicResource Text.Disabled}" Margin="0,0,8,0" />
          <local:Icon x:Name="Spinner" Data="{StaticResource Icon.Loader}" Size="14" Margin="0,0,8,0" Visibility="Collapsed" Foreground="{DynamicResource Text.Muted}" RenderTransformOrigin="0.5,0.5">
            <local:Icon.RenderTransform><RotateTransform x:Name="Spin" /></local:Icon.RenderTransform>
          </local:Icon>
          <TextBlock x:Name="Label" Text="{TemplateBinding Text}" FontSize="{StaticResource FontSize.Control}" FontWeight="Medium" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="Small" Value="True"><Setter TargetName="Body" Property="Height" Value="26" /><Setter TargetName="Body" Property="CornerRadius" Value="{StaticResource Radius.PillSmall}" /><Setter TargetName="Body" Property="Padding" Value="10,0" /><Setter TargetName="Label" Property="FontSize" Value="{StaticResource FontSize.Caption}" /></Trigger>
        <Trigger Property="Kind" Value="ok">
          <Setter TargetName="Body" Property="Background" Value="{DynamicResource Ok.PillBg}" /><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Ok.PillBorder}" />
          <Setter TargetName="DotMark" Property="Fill" Value="{DynamicResource Ok.Dot}" /><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Ok.Text}" />
        </Trigger>
        <Trigger Property="Kind" Value="stale">
          <Setter TargetName="Body" Property="Background" Value="{DynamicResource Warn.PillBg}" /><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Warn.PillBorder}" />
          <Setter TargetName="DotMark" Property="Fill" Value="{DynamicResource Warn.Bar}" /><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Warn.Text}" />
        </Trigger>
        <Trigger Property="Kind" Value="refreshing">
          <Setter TargetName="DotMark" Property="Visibility" Value="Collapsed" /><Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
          <Trigger.EnterActions><BeginStoryboard x:Name="Spinning"><Storyboard><DoubleAnimation Storyboard.TargetName="Spin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><StopStoryboard BeginStoryboardName="Spinning" /></Trigger.ExitActions>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Tooltip card -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /><Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" /><Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
      <Border Background="{DynamicResource Bg.Tooltip}" BorderBrush="{DynamicResource Border.Tooltip}" BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="0,0,10,10" MaxWidth="320">
        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.3" /></Border.Effect>
        <ContentPresenter><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style></ContentPresenter.Resources></ContentPresenter>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Lists used for settings master lists -->
  <Style x:Key="MasterItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" /><Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,0,6" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Body" Padding="12,10" CornerRadius="10" BorderThickness="1" BorderBrush="Transparent" Background="Transparent"><ContentPresenter /></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource Bg.NavHover}" /></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource Accent.SelectedBg}" /><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Accent.SelectedBorder}" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MasterList" TargetType="ListBox">
    <Setter Property="ItemContainerStyle" Value="{StaticResource MasterItem}" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Table rows: subtle hover, selection only shown as focus. -->
  <Style x:Key="TableRow" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Body" Background="Transparent" BorderBrush="{DynamicResource Border.Row}" BorderThickness="0,1,0,0" Padding="28,0"><ContentPresenter /></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource Bg.RowHover}" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource Accent.SelectedBg}" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Dark-aware scrollbars -->
  <Style x:Key="ScrollPage" TargetType="RepeatButton"><Setter Property="Focusable" Value="False" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10" /><Setter Property="MinWidth" Value="10" /><Setter Property="Background" Value="Transparent" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
      <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}" /></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBody" Background="{DynamicResource Border.Input}" CornerRadius="4" Margin="2" MinHeight="18" MinWidth="18" /><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource Text.Disabled}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}" /></Track.IncreaseRepeatButton>
    </Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto" /><Setter Property="MinWidth" Value="0" /><Setter Property="Height" Value="10" /><Setter Property="MinHeight" Value="10" /></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="ScrollViewer"><Setter Property="FocusVisualStyle" Value="{x:Null}" /></Style>
</ResourceDictionary>
