<Window x:Class="AiUsageViewer.App.WidgetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="AI Usage Viewer widget" Style="{StaticResource {x:Type Window}}" Width="370" Height="570" MinWidth="310" MinHeight="310" WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" AllowsTransparency="True" Background="Transparent">
  <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="×" Padding="8,2" Click="HideClick" AutomationProperties.Name="Hide widget" /><TextBlock Text="◈  AI Usage" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" MouseLeftButtonDown="DragHeader" Cursor="SizeAll" /></DockPanel>
      <StackPanel Grid.Row="1" Margin="0,0,0,20"><DockPanel><TextBlock Text="{Binding TodayLabel}" Style="{StaticResource Muted}" /><TextBlock Text="{Binding L[local]}" Style="{StaticResource Muted}" HorizontalAlignment="Right" /></DockPanel><TextBlock Text="{Binding WidgetTotal}" FontSize="36" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Text="{Binding L[tokens]}" Style="{StaticResource Muted}" /></StackPanel>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding WidgetAccounts}" ItemTemplate="{StaticResource WidgetAccountTemplate}" Margin="0,0,5,0" /></ScrollViewer>
      <StackPanel Grid.Row="3" Margin="0,10,0,0"><DockPanel Margin="0,0,0,8" Visibility="{Binding ShowCost,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding L[tokenCost]}" Style="{StaticResource Muted}" FontSize="10" /><TextBlock Text="{Binding WidgetCost}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontSize="11" ToolTip="{Binding WidgetPriceCoverage}" /></DockPanel><TextBlock Text="{Binding WidgetStatus}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" FontSize="10" Margin="0,0,0,10" /><Button Content="{Binding L[details]}" Click="DetailsClick" /></StackPanel>
    </Grid>
  </Border>
</Window>
